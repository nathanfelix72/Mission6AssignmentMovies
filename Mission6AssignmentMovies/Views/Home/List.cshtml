@model List<Movie>

<div class="container mt-4">
    <h2 class="text-center mb-4">Movie List</h2>

    <table class="table table-striped table-hover table-bordered shadow-lg">
        <thead class="table-dark text-center">
            <tr> <!-- Headers! :) -->
                <th>Category</th>
                <th>Title</th>
                <th>Year</th>
                <th>Director</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Lent To</th>
                <th>Copied To Plex</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model) // Print each movie in the table
            {
                <tr class="align-middle">
                    <td>@(movie.Category?.CategoryName ?? "No Category")</td>
                    <td>@movie.Title</td>
                    <td>@movie.Year</td>
                    <td>@movie.Director</td>
                    <td>@movie.Rating</td>
                    <td>@(movie.Edited ? "Yes" : "No")</td>
                    <td>@(string.IsNullOrEmpty(movie.LentTo) ? "N/A" : movie.LentTo)</td>
                    <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                    <td>@(string.IsNullOrEmpty(movie.Notes) ? "No Notes" : movie.Notes)</td>
                    <td class="text-center">
                        <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a class="btn btn-sm btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieId">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
